APP_NAME="1000 Nusantara Rental"
APP_SUB="Dashboard Reservasi"
APP_TIMEZONE=Asia/Jakarta
APP_ENV=local
# Kunci penandatangan sesi + flash + token asisten/parse.
# Wajib minimal 16 karakter. JANGAN commit nilai aslinya.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

BCRYPT_ROUNDS=12

LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentalnusantara
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME=480

# Asisten Data (opsional). Bila ASISTEN_API_KEY kosong, seluruh fitur AI mati
# anggun: /asisten menampilkan peringatan, widget tidak dirender, dan endpoint
# parse-pesanan hanya memakai parser deterministik (tanpa fallback AI).
ASISTEN_API_KEY=
ASISTEN_MODEL=gemini-flash-lite-latest
# Model cadangan, dipisah koma, dicoba berurutan bila model utama gagal.
# Contoh: ASISTEN_MODEL_CADANGAN=gemini-2.0-flash,gemini-1.5-flash
ASISTEN_MODEL_CADANGAN=
ASISTEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta
